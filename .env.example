# GRANTH-AI configuration. Copy to .env (git-ignored) and fill in locally:  cp .env.example .env && chmod 600 .env
# NEVER commit real values. The application works fully with every value below left empty.

# --- generative providers (all optional; default is the local extractive engine, zero external calls) ---
GRANTH_GENERATIVE=off
GRANTH_PROVIDER_ORDER=gemini,huggingface,other,local
GRANTH_MAX_EXTERNAL_CALLS_PER_DAY=50
GRANTH_PROVIDER_TIMEOUT=12

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

HUGGINGFACE_API_TOKEN=
HUGGINGFACE_MODEL=

OTHER_PROVIDER_API_KEY=
OTHER_BASE_URL=
OTHER_PROVIDER_MODEL=

# local OpenAI-compatible model server (e.g. Ollama: http://localhost:11434/v1) - no key needed
LOCAL_MODEL_BASE_URL=
LOCAL_MODEL_NAME=

# --- application ---
GRANTH_ADMIN_TOKEN=
GRANTH_DB_PATH=
GRANTH_PORT=8000
